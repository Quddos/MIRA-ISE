    "position": [-1.35, 2.3, -0.7],
    "rotation_euler_deg": [32.3, 50.7, 0.0],
    "fov_deg": 55.0,
    "near_clip_m": 0.05,
    "far_clip_m": 30.0,
    "width": 640,
    "height": 480,
    "background_rgb": [0.16, 0.17, 0.19]
  },
  "lighting": {
    "directional_rotation_euler_deg": [50.0, -30.0, 0.0],
    "directional_intensity": 1.0,
    "directional_rgb": [1.0, 1.0, 1.0],

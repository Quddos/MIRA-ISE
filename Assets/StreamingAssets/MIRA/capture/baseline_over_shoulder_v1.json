    "target_color_changes_on_acquisition": false
  },
  "skeleton_overlay": {
    "rgb": [0.20, 1.0, 1.0],
    "joint_marker_diameter_m": 0.028,
    "bone_width_m": 0.010,
    "draw_on_top": true,
    "source": "observed (noisy) joint positions from the observation record"
  },
  "benchmark_mode": {
